-- [[ AN ĐẸP TRAI HUB - BLOX FRUITS ]] --

-- 1. Kích hoạt Script Gốc
task.spawn(function()
    pcall(function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/longhihilonghihi-hub/Devs-LongHiHiV2/refs/heads/main/MainV2.txt"))()
    end)
end)

-- 2. Đổi tên Menu & Kích hoạt Fast Attack
task.spawn(function()
    local player = game:GetService("Players").LocalPlayer
    local runService = game:GetService("RunService")
    
    runService.RenderStepped:Connect(function()
        pcall(function()
            -- Đổi tên tiêu đề Menu liên tục thành AN ĐẸP TRAI
            for _, v in pairs(game:GetService("CoreGui"):GetDescendants()) do
                if v:IsA("TextLabel") and (v.Text:find("Long") or v.Text:find("Hub")) then
                    v.Text = "✨ AN ĐẸP TRAI HUB ✨"
                    v.TextColor3 = Color3.fromHSV(tick() % 5 / 5, 1, 1) -- Hiệu ứng đổi màu
                end
            end
            
            -- Ép tốc độ đánh (Fast Attack)
            local char = player.Character
            if char and char:FindFirstChildOfClass("Tool") then
                char:FindFirstChildOfClass("Tool"):Activate()
            end
        end)
    end)
end)

print("--- ĐÃ KÍCH HOẠT SCRIPT AN ĐẸP TRAI ---")
